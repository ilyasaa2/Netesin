# ==============================================================
# KONFIGURASI SERVER NETESIN (UNTIDAR 2026)
# ==============================================================
PORT=3100

# ==============================================================
# KONFIGURASI BASIS DATA CLOUD SUPABASE (POSTGRESQL & REALTIME)
# ==============================================================
# 1. Buka dashboard Supabase (https://supabase.com/dashboard)
# 2. Masuk ke Project Settings > Data API
# 3. Salin Project URL dan Project API Keys (anon public)
# 4. Ubah SUPABASE_ENABLED=true saat sudah memasukkan kredensial
# ==============================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key-here
SUPABASE_TABLE=telemetry
SUPABASE_ENABLED=false
